{
  "name": "mern-bug-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install --prefix client && npm install --prefix server",
    "setup-test-db": "cd server && node src/config/testDb.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "npm run test:unit:client && npm run test:unit:server",
    "test:unit:client": "cd client && npx jest",
    "test:unit:server": "cd server && jest --coverage",
    "test:integration": "cd server && jest tests/integration",
    "test:e2e": "cd client && npx cypress run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.2.0",
    "cypress": "^15.5.0",
    "cypress-image-snapshot": "^4.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "tslib": "^2.8.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/server/tests/setup.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1"
  }
}
